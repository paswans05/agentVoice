# =============================================================================
# agentVoice — Environment Configuration
# Copy this file to .env and adjust values for your local or server setup.
# No paid external AI API keys or cloud accounts are required.
# =============================================================================

# Application
APP_NAME=agentVoice
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Storage (json is default; sqlite is optional)
STORAGE_BACKEND=json
DATA_DIR=./agentvoice-data

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=agentVoice

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local LLM Runtime (Ollama - used in Phase 3+)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=qwen2.5:7b-instruct

# Security (required for VPS/server mode in Phase 10+)
# Generate a strong random secret for production: openssl rand -hex 32
AGENTVOICE_SECRET_KEY=change-me-in-production
REQUIRE_AUTH=false
