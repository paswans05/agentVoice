# Auto-generated by scripts/setup-iphone-https.ps1 for LAN IP: 192.168.1.11
https://192.168.1.11:443 {
    tls D:/open-source/agentVoice/scripts/../certs/agentvoice-lan.pem D:/open-source/agentVoice/scripts/../certs/agentvoice-lan-key.pem

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

# Dedicated HTTPS origin for agentvoice-phone-web (iPhone Safari PWA)
https://192.168.1.11:8443 {
    tls D:/open-source/agentVoice/scripts/../certs/agentvoice-lan.pem D:/open-source/agentVoice/scripts/../certs/agentvoice-lan-key.pem

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3001
    }
}
